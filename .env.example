# ---------------------------------------------------------------------------
# AgentMatrix-SC 环境变量模板
# 复制为 .env 后按需修改；.env 不入库
# ---------------------------------------------------------------------------

# --- 运行模式 ---
APP_ENV=development
LOG_LEVEL=INFO

# --- 数据库（容器内主机名为 postgres）---
POSTGRES_USER=agentmatrix
POSTGRES_PASSWORD=agentmatrix_dev_pwd
POSTGRES_DB=agentmatrix
DATABASE_URL=postgresql+psycopg://agentmatrix:agentmatrix_dev_pwd@postgres:5432/agentmatrix

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- 鉴权 ---
# 生产必须替换；生成方式: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- 调度策略 ---
# s0_all_large | s1_fixed_rule | s2_weighted | s3_cost_aware | s4_llm_planner
# 默认用 s4（本文方案：大模型规划 + 规则校验）；对比实验以 s2 作为产品基线。
DISPATCH_STRATEGY=s4_llm_planner
DISPATCH_SLA_HEADROOM=0.8
DISPATCH_MIN_SUCCESS_RATE=0.85

# --- LLM 网关（默认 mock，离线可演示）---
LLM_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=

# --- 演示开关 ---
# 1 = 种子数据带故障注入，用于演示重试与告警
DEMO_FAULT_INJECTION=0
